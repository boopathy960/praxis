# Copy to .env and fill in real values. .env is gitignored.
# Remote reasoning executor for ASC2 (any OpenAI-compatible chat/completions API).
# Default: NVIDIA's API (build.nvidia.com) running Nemotron 3 Ultra. Get a key at
# https://build.nvidia.com (keys look like `nvapi-...`). Any OpenAI-compatible
# endpoint also works (Gemini, OpenAI, local Ollama, etc.).
ASTRA_ASC2_REMOTE_ENDPOINT=https://integrate.api.nvidia.com/v1
ASTRA_ASC2_REMOTE_API_KEY=your-nvapi-key-here
ASTRA_ASC2_REMOTE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional tuning (defaults shown). Nemotron is a reasoning model, so keep the
# token budget generous and let the client stream (large models are slow to
# first token when buffered).
ASTRA_ASC2_REMOTE_MAX_TOKENS=2048
ASTRA_ASC2_REMOTE_TIMEOUT_SECS=300
ASTRA_ASC2_REMOTE_STREAM=true

# Telegram bot (optional). Create a bot with @BotFather and paste its token
# here to enable the bot worker. Leave empty to keep the bot disabled.
ASTRA_TELEGRAM_BOT_TOKEN=
# Optional comma-separated chat-id allowlist; empty = anyone can use the bot
# (each user must still bring their own API key).
ASTRA_TELEGRAM_ALLOWED_CHAT_IDS=
